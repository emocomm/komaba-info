{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Jekyll dev server",
      "runtimeExecutable": "bundle",
      "runtimeArgs": ["exec", "jekyll", "serve"],
      "port": 4000
    },
    {
      "name": "Jekyll dev server (livereload)",
      "runtimeExecutable": "bundle",
      "runtimeArgs": ["exec", "jekyll", "serve", "--livereload"],
      "port": 4000
    }
  ]
}
